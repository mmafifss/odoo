<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree / List View -->
        <record id="estate_property_view_tree" model="ir.ui.view">
            <field name="name">estate.property.tree</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <tree string="Properties">
                    <field name="name"/>
                    <field name="postcode"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <field name="expected_price"/>
                    <field name="selling_price"/>
                    <field name="date_availability"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="estate_property_view_form" model="ir.ui.view">
            <field name="name">estate.property.form</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <form string="Property">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Contoh: Villa Mewah di Jimbaran"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <group>
                                <field name="expected_price"/>
                                <field name="selling_price"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Deskripsi &amp; Detail">
                                <group>
                                    <field name="description"/>
                                    <field name="bedrooms"/>
                                    <field name="living_area"/>
                                    <field name="facades"/>
                                    <field name="garage"/>
                                    <field name="garden"/>
                                    <field name="garden_area" invisible="not garden"/>
                                    <field name="garden_orientation" invisible="not garden"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="estate_property_view_search" model="ir.ui.view">
            <field name="name">estate.property.search</field>
            <field name="model">estate.property</field>
            <field name="arch" type="xml">
                <search string="Search Properties">
                    <field name="name"/>
                    <field name="postcode"/>
                    <field name="expected_price"/>
                    <field name="bedrooms"/>
                    <field name="living_area"/>
                    <filter string="Available" name="available" domain="[('state', 'in', ('new', 'offer_received'))]"/>
                    <group expand="0" string="Group By">
                        <filter string="Postcode" name="group_by_postcode" context="{'group_by': 'postcode'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action Window -->
        <record id="estate_property_action" model="ir.actions.act_window">
            <field name="name">Properties</field>
            <field name="res_model">estate.property</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_available': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Buat properti pertama Anda!
                </p>
            </field>
        </record>

        <!-- Menu Hierarchy -->
        <menuitem id="estate_menu_root" name="Real Estate" sequence="10"/>
        <menuitem id="estate_first_level_menu" name="Advertisements" parent="estate_menu_root" sequence="10"/>
        <menuitem id="estate_property_menu_action" name="Properties" parent="estate_first_level_menu" action="estate_property_action" sequence="10"/>
    </data>
</odoo>
